# AWS DynamoDB/SQS execution runtime. Replace every example value before deployment; do not
# commit credentials, API keys, lease tokens, or signed AWS URLs.
ExecutionRuntime__Adapter=aws-dynamodb-sqs
ExecutionRuntime__AdapterId=aws-dynamodb-sqs
ExecutionRuntime__Aws__Region=us-east-1
ExecutionRuntime__Aws__DynamoDbTableName=vyral-execution-production
ExecutionRuntime__Aws__SqsQueueUrl=https://sqs.us-east-1.amazonaws.com/YOUR_AWS_ACCOUNT_ID/vyral-execution-production
ExecutionRuntime__Aws__Root=vyral-execution-production
ExecutionRuntime__Aws__CreateTableIfMissing=false
ExecutionRuntime__Aws__RequireExplicitWorkerRoutes=true
ExecutionRuntime__Aws__MaximumDelaySeconds=900
ExecutionRuntime__Aws__MaintenanceScanLimit=10000

# Every externally leased handler has an explicit route. Set a distinct queue only where the
# product intentionally needs isolation; otherwise it can use the runtime default queue above.
ExecutionRuntime__Aws__WorkerRoutes__0__HandlerId=product.example.job
ExecutionRuntime__Aws__WorkerRoutes__0__SqsQueueUrl=https://sqs.us-east-1.amazonaws.com/YOUR_AWS_ACCOUNT_ID/vyral-execution-production
ExecutionRuntime__ExternalHandlers__0__HandlerId=product.example.job
ExecutionRuntime__ExternalHandlers__0__PluginId=product.example
ExecutionRuntime__ExternalHandlers__0__DisplayName=Product example worker

# Bind every worker identity to an explicit product policy. The server's execution access policy
# supplies the corresponding authenticated caller/worker authorization boundary.
ExecutionRuntime__ProductPolicies__0__ProductId=product-example
ExecutionRuntime__ProductPolicies__0__AllowedServiceIdentities__0=product-example-worker
ExecutionRuntime__ProductPolicies__0__AllowedHandlerIds__0=product.example.job
