{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvyral.com/conformance/runtime/v1/manifest.schema.json",
  "title": "Vyral portable runtime conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "fixtureVersion",
    "contractVersion",
    "minimumRunnerVersion",
    "scenarioSchema",
    "profiles",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "manifest.schema.json"
    },
    "fixtureVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minimumRunnerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenarioSchema": {
      "$ref": "#/$defs/artifact"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^vyral\\.runtime\\.[a-z0-9.-]+\\.v[0-9]+$"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "profile",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+\\.v[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "profile": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "golden",
              "stateful",
              "black-box",
              "fault"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
