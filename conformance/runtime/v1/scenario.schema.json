{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvyral.com/conformance/runtime/v1/scenario.schema.json",
  "title": "Vyral portable runtime conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "fixtureVersion",
    "profile",
    "kind",
    "steps"
  ],
  "properties": {
    "$schema": {
      "const": "../../scenario.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+\\.v[0-9]+$"
    },
    "fixtureVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "type": "string",
      "pattern": "^vyral\\.runtime\\.[a-z0-9.-]+\\.v[0-9]+$"
    },
    "kind": {
      "enum": [
        "golden",
        "stateful",
        "black-box",
        "fault"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "arguments",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "arguments": {
          "type": "object"
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": true
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "class"
                  ],
                  "properties": {
                    "class": {
                      "type": "string"
                    },
                    "messageContains": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
