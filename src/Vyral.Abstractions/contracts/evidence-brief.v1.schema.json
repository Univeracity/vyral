{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvyral.com/contracts/evidence-brief.v1.schema.json",
  "title": "Vyral EvidenceBrief v1",
  "description": "A dated, source-grounded evidence artifact. It deliberately excludes generated answers, persona prompts, and truth adjudication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "question",
    "asOfUtc",
    "factAnchors",
    "sourceSnapshots",
    "citations",
    "counterEvidence",
    "uncertainties",
    "retrievalTraces"
  ],
  "properties": {
    "schema": { "const": "vyral.evidence-brief.v1" },
    "id": { "$ref": "#/$defs/id" },
    "question": { "$ref": "#/$defs/text" },
    "asOfUtc": { "$ref": "#/$defs/utcDateTime" },
    "factAnchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/factAnchor" }
    },
    "sourceSnapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/sourceSnapshot" }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/citation" }
    },
    "counterEvidence": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/counterEvidence" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "retrievalTraces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/retrievalTrace" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" },
    "utcDateTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "factAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceSnapshotIds", "citationIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "sourceSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } },
        "citationIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "contentHash", "capturedAtUtc"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "uri": { "type": "string", "format": "uri", "maxLength": 4096, "pattern": "^(?:https?://[^/?#@]+(?:/[^?#]*)?|vyral://[^/?#@]+(?:/[^?#]*)?|urn:[^?#]+)$" },
        "contentHash": { "$ref": "#/$defs/digest" },
        "capturedAtUtc": { "$ref": "#/$defs/utcDateTime" },
        "publishedAtUtc": { "$ref": "#/$defs/utcDateTime" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceSnapshotId", "factAnchorIds", "counterEvidenceIds", "displayText"],
      "anyOf": [
        { "properties": { "factAnchorIds": { "minItems": 1 } } },
        { "properties": { "counterEvidenceIds": { "minItems": 1 } } }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceSnapshotId": { "$ref": "#/$defs/id" },
        "factAnchorIds": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/id" } },
        "counterEvidenceIds": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/id" } },
        "displayText": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "counterEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceSnapshotIds", "citationIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "sourceSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } },
        "citationIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "level", "factAnchorIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "level": { "enum": ["low", "medium", "high", "unknown"] },
        "factAnchorIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "retrievalTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "retrievedAtUtc", "queryHash", "matches"],
      "properties": {
        "traceId": { "$ref": "#/$defs/id" },
        "retrievedAtUtc": { "$ref": "#/$defs/utcDateTime" },
        "queryHash": { "$ref": "#/$defs/digest" },
        "matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/retrievalMatch" }
        }
      }
    },
    "retrievalMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "recordId", "rank", "sourceSnapshotIds"],
      "properties": {
        "collection": { "$ref": "#/$defs/id" },
        "recordId": { "$ref": "#/$defs/id" },
        "rank": { "type": "integer", "minimum": 1 },
        "sourceSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
