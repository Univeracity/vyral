<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vyral.Primitives\Vyral.Primitives.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <PackageId>Vyral.Execution</PackageId>
    <Title>Vyral Execution</Title>
    <Authors>Vyral</Authors>
    <Company>Vyral</Company>
    <Copyright>Copyright © 2026 Jeremy Dixon</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Provider-neutral execution runtime contracts for jobs, runs, steps, plugins, leases, retries, timers, events, cancellation, artifacts, traces, status, and idempotency.</Description>
    <PackageTags>vyral;execution;orchestration;jobs;runs;plugins;provider-neutral</PackageTags>
    <PackageProjectUrl>https://github.com/univeracity/vyral</PackageProjectUrl>
    <RepositoryUrl>https://github.com/univeracity/vyral</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
