<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vyral.Execution\Vyral.Execution.csproj" />
    <ProjectReference Include="..\Vyral.Primitives\Vyral.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <PackageId>Vyral.Execution.Local</PackageId>
    <Title>Vyral Execution Local</Title>
    <Authors>Vyral</Authors>
    <Company>Vyral</Company>
    <Copyright>Copyright © 2026 Jeremy Dixon</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>SQLite-backed local execution runtime adapter for provider-neutral Vyral jobs, runs, plugins, leases, retries, timers, events, artifacts, traces, and status surfaces.</Description>
    <PackageTags>vyral;execution;orchestration;jobs;runs;plugins;local;sqlite</PackageTags>
    <PackageProjectUrl>https://github.com/univeracity/vyral</PackageProjectUrl>
    <RepositoryUrl>https://github.com/univeracity/vyral</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
