<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vyral.Execution\Vyral.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.18.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <PackageId>Vyral.Execution.Temporal</PackageId>
    <Title>Vyral Execution Temporal</Title>
    <Authors>Vyral</Authors>
    <Company>Vyral</Company>
    <Copyright>Copyright © 2026 Jeremy Dixon</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Temporal coordination adapter foundation for provider-neutral Vyral execution runs, dispatch reconciliation, signals, retries, waits, and cancellation.</Description>
    <PackageTags>vyral;execution;orchestration;temporal;durable-workflows</PackageTags>
    <PackageProjectUrl>https://github.com/univeracity/vyral</PackageProjectUrl>
    <RepositoryUrl>https://github.com/univeracity/vyral</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
